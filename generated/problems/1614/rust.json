          "code": "impl Solution {\n    pub fn max_depth(s: String) -> i32 {\n        s.chars().scan(0, |acc, c| {\n            *acc += i32::from(c == '(');\n            *acc -= i32::from(c == ')');\n            Some(*acc)\n        }).max().unwrap_or(0)\n    }\n}\n\nstruct Solution {}\n",

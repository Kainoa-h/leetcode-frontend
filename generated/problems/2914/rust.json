          "code": "impl Solution {\n    pub fn min_changes(s: String) -> i32 {\n        s.as_bytes()\n            .chunks_exact(2)\n            .map(|c| i32::from(c[0] != c[1]))\n            .sum()\n    }\n}\n\nstruct Solution {}\n",

          "code": "impl Solution {\n    pub fn count_commas(mut n: i64) -> i64 {\n        if n < 1_000 {\n            return 0;\n        }\n        let mut place = 1_000;\n        let mut count = 0;\n        while place <= n {\n            count += n - place + 1;\n            place *= 1_000;\n        }\n        count\n    }\n}\n\nstruct Solution {}\n",

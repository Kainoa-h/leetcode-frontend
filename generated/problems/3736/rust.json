          "code": "impl Solution {\n    pub fn min_moves(nums: Vec<i32>) -> i32 {\n        let (sum, max) = nums\n            .iter()\n            .fold((0, 0), |(sum, max), &x| (sum + x, max.max(x)));\n\n        max * nums.len() as i32 - sum\n    }\n}\n\nstruct Solution {}\n",

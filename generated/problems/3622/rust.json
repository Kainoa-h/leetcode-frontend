          "sourceFilename": "3622_check_divisibility_by_digit_sum_and_product.rs",
          "code": "impl Solution {\n    pub fn check_divisibility(n: i32) -> bool {\n        let mut x = n;\n        let mut sum = 0;\n        let mut prod = 1;\n        while x > 0 {\n            let d = x % 10;\n            x /= 10;\n            sum += d;\n            prod *= d;\n        }\n        n % (sum + prod) == 0\n    }\n}\n\nstruct Solution {}\n",

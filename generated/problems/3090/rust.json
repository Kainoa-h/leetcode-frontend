          "sourceFilename": "3090_maximum_length_substring_with_two_occurances.rs",
          "code": "impl Solution {\n    pub fn maximum_length_substring(s: String) -> i32 {\n        let s = s.as_bytes();\n        let mut buckets = [0;256];\n        let mut start = 0;\n        let mut max = 0;\n        for (end, &c) in s.iter().enumerate() {\n            let c = c as usize;\n            buckets[c] += 1;\n            while buckets[c] > 2 {\n                buckets[s[start] as usize] -= 1;\n                start += 1;\n            }\n            max = max.max(end - start + 1);\n        }\n        max as i32\n    }\n}\n\nstruct Solution {}\n",

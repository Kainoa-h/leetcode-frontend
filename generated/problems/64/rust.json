          "sourceFilename": "64_minimum_path_sum.rs",
          "code": "impl Solution {\n    pub fn min_path_sum(mut grid: Vec<Vec<i32>>) -> i32 {\n        let rows = grid.len();\n        let cols = grid[0].len();\n\n        for i in 1..rows {\n            grid[i][0] += grid[i - 1][0];\n        }\n\n        for i in 1..cols {\n            grid[0][i] += grid[0][i - 1];\n        }\n\n        for r_idx in 1..rows {\n            for c_idx in 1..cols {\n                grid[r_idx][c_idx] += grid[r_idx - 1][c_idx].min(grid[r_idx][c_idx - 1]);\n            }\n        }\n\n        grid[rows - 1][cols - 1]\n    }\n}\n\nstruct Solution {}\n",

          "sourceFilename": "2384_largest_palindromic_number.java",
          "code": "class Solution {\n  public String largestPalindromic(String num) {\n    int[] bucket = new int[10];\n    for (int i = 0; i < num.length(); i++) {\n      bucket[num.charAt(i) - '0']++;\n    }\n    \n    StringBuilder left = new StringBuilder();\n    for (int i = 9; i >= 0; i--) {\n      var count = bucket[i];\n      if (count > 1 && (i != 0 || left.length() != 0)) {\n        var use = count / 2;\n        left.append(String.valueOf(i).repeat(use));\n        bucket[i] -= use * 2;\n      }\n    }\n\n    String mid = \"\";\n    for (int i = 9; i >= 0; i--) {\n      var count = bucket[i];\n      if (count > 0) {\n        mid = String.valueOf(i);\n        break;\n      }\n    }\n\n    StringBuilder right = new StringBuilder(left);\n    right.reverse();\n\n    left.append(mid);\n    left.append(right);\n\n    return left.toString();\n  }\n}\n",
